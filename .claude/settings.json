{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/sync-main.sh --force 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Syncing with origin/main"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/sync-main.sh 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
