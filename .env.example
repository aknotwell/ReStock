# Copy to .env and fill in. Never commit .env.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Claude API (AI layer, Person 1)
ANTHROPIC_API_KEY=

# Photon 2.0 (messaging, Person 1) — see photon.co/beta
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=

# Stripe TEST MODE ONLY (payments, Person 3) — setup steps in docs/stripe.md
# Secret key from a Stripe sandbox: Developers → API keys. Must start with sk_test_
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen --print-secret` (CLI logged in to the same sandbox as the key)
STRIPE_WEBHOOK_SECRET=whsec_
