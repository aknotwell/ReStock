# Copy to .env and fill in. Never commit .env.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Claude API (AI layer)
ANTHROPIC_API_KEY=

# Photon 2.0 (messaging) — dashboard: https://app.beta.photon.codes
# Project API key (pho_sk_...) with project:read + project:write
PHOTON_API_KEY=
PHOTON_PROJECT_ID=pho_prj_
PHOTON_PLATFORM=imessage

# Demo / local dev
DEMO_SEED=1            # seed Sam/Jake/Priya at server start (skipped if the database already has a household)
DEMO_RESET=0           # 1 = re-seed the demo even if saved data exists
# SQLite file that keeps data across restarts. Leave empty for in-memory only.
# On Railway, attaching a volume sets this automatically (<mount>/restock.db).
DATABASE_PATH=./.data/restock.db
DEV_INBOUND=0          # 1 = enable POST /dev/inbound to simulate texts locally (never in prod)
# Real iMessage handles for the demo household (E.164 or iMessage email). Not committed.
DEMO_PHONE_SAM=
DEMO_PHONE_JAKE=
DEMO_PHONE_PRIYA=
# Photon group space ID (pho_spc_...). Optional: the first group text from a member binds it.
DEMO_GROUP_SPACE_ID=

# Stripe TEST MODE ONLY (payments) — setup steps in docs/stripe.md
# Secret key from a Stripe sandbox: Developers → API keys. Must start with sk_test_
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen --print-secret` (CLI logged in to the same sandbox as the key)
STRIPE_WEBHOOK_SECRET=whsec_

# Live store prices for the "Which one?" options (SerpApi Google Shopping, free tier: 250 searches/month).
# Leave empty to use catalog prices only. Results are cached, so one search covers a product for 12 hours.
SERPAPI_KEY=
DEALS_LOCATION=        # optional, e.g. Seattle, Washington, United States
DEALS_DAILY_LIMIT=25   # cap on live searches per day
DEALS_ANY_STORE=0      # 1 = include small sellers and marketplace resellers, not just major retailers

# POST /api/agent (VEYZL audit target). If set, callers must send "Authorization: Bearer <token>".
AGENT_API_TOKEN=
