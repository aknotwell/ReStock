# Copy to .env and fill in. Never commit .env.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Claude API (AI layer, Person 1)
ANTHROPIC_API_KEY=

# Photon 2.0 (messaging, Person 1) — dashboard: https://app.beta.photon.codes
# Project API key (pho_sk_...) with project:read + project:write
PHOTON_API_KEY=
PHOTON_PROJECT_ID=pho_prj_
PHOTON_PLATFORM=imessage

# Demo / local dev
DEMO_SEED=1            # seed Sam/Jake/Priya at server start
DEV_INBOUND=0          # 1 = enable POST /dev/inbound to simulate texts locally (never in prod)
# Real iMessage handles for the demo household (E.164 or iMessage email). Not committed.
DEMO_PHONE_SAM=
DEMO_PHONE_JAKE=
DEMO_PHONE_PRIYA=
# Photon group space ID (pho_spc_...). Optional: the first group text from a member binds it.
DEMO_GROUP_SPACE_ID=

# Stripe TEST MODE ONLY (payments, Person 3) — must start with sk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
